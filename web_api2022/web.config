<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>
		<security>
			<requestFiltering>
				<!-- 1. 增加允许的请求长度 (单位：字节) 
             这里设置为 209715200 (约 200MB) -->
				<requestLimits maxAllowedContentLength="209715200" />
			</requestFiltering>
		</security>

		<aspNetCore processPath="dotnet" arguments=".\web_api2022.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
			<handlerSettings>
				<!-- 2. 增加请求超时时间，防止跨境网络搬运大文件时连接被 IIS 强行切断 -->
				<handlerSetting name="requestTimeout" value="00:10:00" />
			</handlerSettings>
		</aspNetCore>
	</system.webServer>
</configuration>